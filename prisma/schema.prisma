generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Workspace {
  id       String @id @default("demo")
  revision Int    @default(0)
  payload  Json
}
model ScheduleVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  payload   Json
}
model AuditEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  payload   Json
}
model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  payload   Json
}
