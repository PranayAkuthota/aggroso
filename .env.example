# Backend (Railway injects DATABASE_URL from its PostgreSQL service)
DATABASE_URL=postgresql://dispatch:dispatch_local_only@localhost:55432/dispatch?schema=public
PORT=8000
NODE_ENV=development
AI_PROVIDER=mock
# For the hosted submission set AI_PROVIDER=openai and provide a secure key:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_API_KEY is also supported for cloud environments with reserved OPENAI_ names.
LLM_API_KEY=
# Required in production. Use a long random token and provide it privately to reviewers.
APP_ACCESS_TOKEN=
# Exact Vercel origin. Comma-separated origins supported; no wildcard.
FRONTEND_ORIGIN=http://localhost:5173

# Gemini alternative: AI_PROVIDER=gemini (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
